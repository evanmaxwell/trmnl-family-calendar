{% comment %}
  Week Agenda - TRMNL private plugin (full view).
  A companion to full.liquid for the same playlist: the current week
  (Sunday to Saturday, or from the configured first day) as an easy-to-read
  list in a 4 x 2 grid: three days and today's weather on the top row, four
  days on the bottom row, with each event's time beside its title. The
  today marker moves through the week; earlier days are grayed out. It reads the same three polling URLs as full.liquid:
    IDX_0 = ?src=cal, IDX_1 = ?src=weather, IDX_2 = ?src=aqi (unused here).
  Design size is 800 x 480; fitToScreen() scales it to the device.
{% endcomment %}

<style>
  * { box-sizing: border-box; }
  .screen, .view, .layout, .layout--col, .layout--row { padding: 0 !important; margin: 0 !important; }
  /* Sized by fitToScreen() in the script; see full.liquid.template for why. */
  #ag-container { position: fixed; left: 0; top: 0; transform-origin: 0 0; background: #fff; z-index: 1; }
  .ag-wrap { width: 100%; height: 100%; display: flex; flex-direction: column; overflow: hidden;
    font-family: -apple-system, 'Helvetica Neue', Arial, sans-serif; -webkit-font-smoothing: none; color: #000; }
  .ag-cols { flex: 1; display: flex; flex-direction: column; min-height: 0; }
  .ag-row { flex: 1; display: flex; min-height: 0; }
  .ag-row + .ag-row { border-top: 2px solid #000; }
  .ag-col { flex: 1; display: flex; flex-direction: column; min-width: 0; border-left: 2px solid #000; }
  .ag-col:first-child { border-left: none; }

  .ag-head { background: #000; color: #fff; display: flex; align-items: baseline; justify-content: space-between; gap: 6px; padding: 2px 6px 1px; white-space: nowrap; }
  /* Past days: light gray header. Today: black header and a thick outline. Later days: dark gray. */
  .ag-head { background: #555; }
  .ag-col.is-today { box-shadow: inset 0 0 0 3px #000; }
  .ag-col.is-today .ag-head { background: #000; }
  .ag-weather .ag-head { background: #000; }
  /* Past days: near-black #333 text and a #DDD header. The TRMNL X draws 16 native
     grays, so these two shades do not dither there; #AAA and #555 text read too faint
     on e-ink. A 2-bit TRMNL OG dithers them (see ADR 0004). */
  .ag-col.is-pastday .ag-head { background: #DDD; color: #333; }
  .ag-col.is-pastday .ag-allday { color: #333; border-color: #333; font-weight: normal; }
  .ag-col.is-pastday .ag-allday.is-invert { background: #333; color: #fff; }
  .ag-day { font-size: 15px; font-weight: bold; }
  .ag-date { font-size: 12px; font-weight: bold; }

  .ag-wx { display: flex; align-items: center; gap: 5px; padding: 1px 6px; border-bottom: 1px solid #000; height: 24px; }
  .ag-wx svg { width: 20px; height: 20px; flex-shrink: 0; }
  .ag-temps { font-size: 13px; }
  .ag-temps b { font-weight: bold; }
  .ag-wx-extra { margin-left: auto; font-size: 11px; color: #555; display: flex; align-items: center; gap: 2px; }
  .ag-wx-extra svg { width: 13px; height: 13px; }

  .ag-list { flex: 1; min-height: 0; overflow: hidden; padding: 3px 5px 0; display: flex; flex-direction: column; gap: 3px; }
  .ag-allday { display: flex; align-items: stretch; font-size: 12px; font-weight: bold; border: 1px solid #000; min-height: 17px; flex-shrink: 0; }
  .ag-allday .ag-bar { width: 5px; flex-shrink: 0; }
  .ag-allday span { padding: 1px 4px; line-height: 1.15; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; word-break: break-word; }
  .ag-allday.is-invert { background: #000; color: #fff; }

  .ag-evt { display: flex; align-items: stretch; gap: 5px; padding: 2px 0 3px; border-bottom: 1px dashed #AAA; flex-shrink: 0; }
  .ag-evt .ag-bar { width: 5px; flex-shrink: 0; }
  .ag-time { width: 58px; flex-shrink: 0; line-height: 1.15; }
  .ag-start { font-size: 12px; font-weight: bold; white-space: nowrap; }
  .ag-end { font-size: 10px; color: #555; white-space: nowrap; }
  .ag-body { flex: 1; min-width: 0; line-height: 1.15; }
  .ag-title { font-size: 13px; font-weight: bold; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; word-break: break-word; }
  .ag-loc { font-size: 10px; color: #555; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .ag-evt.is-past .ag-start, .ag-evt.is-past .ag-title { color: #333; font-weight: normal; }
  .ag-evt.is-past .ag-end, .ag-evt.is-past .ag-loc { color: #333; }
  .ag-empty { font-size: 12px; color: #555; padding: 6px 2px; }
  /* Weekly chore reminders, pinned to the bottom of the day column (see DAY_NOTES). */
  .ag-note { flex: none; margin: 0 5px 4px; padding: 3px 4px 0; border-top: 1px dashed #555; font-size: 12px; font-weight: bold; color: #000; }
  .ag-col.is-pastday .ag-note { color: #333; font-weight: normal; }
  .ag-more { font-size: 12px; font-weight: bold; color: #555; padding: 2px 2px 4px; }

  .ag-legend { flex-shrink: 0; display: flex; align-items: center; gap: 12px; padding: 4px 8px; border-top: 2px solid #000; font-size: 11px; white-space: nowrap; overflow: hidden; }
  .ag-legend-item { display: flex; align-items: center; gap: 4px; }
