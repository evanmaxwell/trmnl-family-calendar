  .ag-bar-2 { background: #fff; border: 1px solid #000; }
  .ag-bar-4 { background: repeating-linear-gradient(-45deg, #000 0px, #000 1.5px, #fff 1.5px, #fff 3px); }
  .ag-bar-5 { background: repeating-linear-gradient(0deg, #AAA 0px, #AAA 2px, #fff 2px, #fff 4px); }
  .ag-bar-7 { background: repeating-linear-gradient(0deg, #000 0px, #000 2px, #fff 2px, #fff 4px); }
  .ag-bar-10 { background: repeating-linear-gradient(45deg, #000 0px, #000 1.5px, #fff 1.5px, #fff 3px); }

  .ag-error { padding: 20px; font-size: 16px; }

  /* Today's weather tile (top right). */
  .ag-now { display: flex; align-items: center; gap: 8px; padding: 6px 8px 2px; }
  .ag-now svg { width: 52px; height: 52px; flex-shrink: 0; }
  .ag-now-temp { font-size: 40px; font-weight: bold; line-height: 1; }
  .ag-now-hilo { font-size: 13px; color: #555; }
  .ag-now-hilo b { color: #000; }
  .ag-facts { padding: 2px 8px; font-size: 12px; line-height: 1.45; }
